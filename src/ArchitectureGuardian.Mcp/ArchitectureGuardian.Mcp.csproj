<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>archguard-mcp</ToolCommandName>
    <Description>Read-only architecture context and solution analysis over MCP stdio.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ArchitectureGuardian.Analysis/ArchitectureGuardian.Analysis.csproj" />
    <ProjectReference Include="../ArchitectureGuardian.Configuration/ArchitectureGuardian.Configuration.csproj" />
    <InternalsVisibleTo Include="ArchitectureGuardian.ArchitectureTests" />
  </ItemGroup>
</Project>
