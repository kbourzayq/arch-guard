<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- MSBuildWorkspace needs the reference output path to match compiler-hosted project references. -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);PORTABLE_POLICY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <Compile Include="../ArchitectureGuardian.Core/Policies/ModulePolicy.cs" Link="Documents/ModulePolicy.cs" />
    <Compile Include="../ArchitectureGuardian.Core/Policies/LayerPolicy.cs" Link="Documents/LayerPolicy.cs" />
    <Compile Include="../ArchitectureGuardian.Core/Policies/ContractPolicy.cs" Link="Documents/ContractPolicy.cs" />
    <Compile Include="../ArchitectureGuardian.Core/Policies/DomainInfrastructurePolicy.cs" Link="Documents/DomainInfrastructurePolicy.cs" />
    <Compile Include="../ArchitectureGuardian.Core/Policies/PolicyData.cs" Link="Documents/PolicyData.cs" />
    <Compile Include="../ArchitectureGuardian.Core/Policies/ProjectPattern.cs" Link="Documents/ProjectPattern.cs" />
    <Compile Include="../ArchitectureGuardian.Core/Rules/ForbiddenReferenceSemantics.cs" Link="Validation/ForbiddenReferenceSemantics.cs" />
  </ItemGroup>
</Project>
