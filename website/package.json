{
  "name": "architecture-guardian-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "check": "npm run sync && astro check",
    "test": "node --test scripts/*.test.mjs",
    "build": "npm run test && npm run check && astro build && node scripts/check-links.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.4",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "fflate": "0.8.3",
    "github-slugger": "^2.0.0",
    "jsdom": "30.1.3",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
