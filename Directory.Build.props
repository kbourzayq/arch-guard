<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Synchronized from .cz.toml by Commitizen's version_files setting. -->
    <Version>0.3.0</Version>
    <!-- Only the CLI, MCP host and compiler adapter are distribution contracts. -->
    <IsPackable>false</IsPackable>
    <Authors>Khalid BOURZAYQ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kbourzayq/arch-guard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kbourzayq/arch-guard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>architecture;dotnet;analysis</PackageTags>
    <PackageReleaseNotes>https://github.com/kbourzayq/arch-guard/blob/v$(Version)/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
</Project>
