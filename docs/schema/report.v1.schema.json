{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "failed",
        "cancelled"
      ]
    },
    "gateOutcome": {
      "enum": [
        "passed",
        "failed",
        "notEvaluated"
      ]
    },
    "baselineApplied": {
      "type": "boolean"
    },
    "baseCommit": {
      "type": [
        "string",
        "null"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "documentationUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title",
          "documentationUrl"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "resolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "ruleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/$defs/location"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "ruleId",
          "location"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "gateOutcome",
    "baselineApplied",
    "baseCommit",
    "rules",
    "diagnostics",
    "resolved",
    "issues"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kbourzayq/arch-guard/blob/main/docs/schema/report.v1.schema.json",
  "title": "Architecture Guardian analysis report v1",
  "$defs": {
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "properties": {
            "module": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "module",
            "symbol"
          ],
          "additionalProperties": false
        },
        "dependencyPath": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "identity": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "identity"
            ],
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string"
              },
              "setting": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "scope",
              "setting",
              "values"
            ],
            "additionalProperties": false
          }
        },
        "snapshotId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fingerprint",
        "ruleId",
        "target",
        "dependencyPath",
        "constraints",
        "snapshotId"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "properties": {
            "module": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "module",
            "symbol"
          ],
          "additionalProperties": false
        },
        "dependencyPath": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "identity": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "identity"
            ],
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string"
              },
              "setting": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "scope",
              "setting",
              "values"
            ],
            "additionalProperties": false
          }
        },
        "snapshotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "location": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/location"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "description",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "publicContracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediation": {
          "type": "string"
        },
        "documentationUrl": {
          "type": "string",
          "format": "uri"
        },
        "baselineState": {
          "enum": [
            null,
            "existing",
            "new"
          ]
        }
      },
      "required": [
        "fingerprint",
        "ruleId",
        "target",
        "dependencyPath",
        "constraints",
        "snapshotId",
        "id",
        "severity",
        "message",
        "location",
        "evidence",
        "publicContracts",
        "remediation",
        "documentationUrl",
        "baselineState"
      ],
      "additionalProperties": false
    }
  }
}
